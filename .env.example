# Plantilla de variables de entorno para Yaiwell.
#
# Este archivo SÍ se commitea: sirve como referencia para que cualquier
# desarrollador sepa qué variables necesita configurar. Los valores reales
# (claves, secretos, URLs de producción) van en `.env.local`, que está
# gitignored y NUNCA debe subirse al repositorio.
#
# Copia este archivo a `.env.local` y rellena los valores antes de arrancar
# el proyecto en local.

# === Supabase ===
# Conexión Postgres directa (puerto 5432, host `db.<ref>.supabase.co`).
# Se usa tanto por el CLI de Prisma (migrate, studio) como por el runtime
# en desarrollo. Formato:
#   postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres
# Cuando deployemos a Vercel introduciremos un POOLER_URL aparte para el
# runtime serverless (pgBouncer en port 6543).
DATABASE_URL=
# URL pública del proyecto Supabase, expuesta al cliente.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima pública de Supabase, expuesta al cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service role de Supabase, SOLO en servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# === Clerk ===
# Clave publicable de Clerk, expuesta al cliente.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clave secreta de Clerk, SOLO en servidor.
CLERK_SECRET_KEY=
# Secreto para verificar la firma de los webhooks de Clerk.
CLERK_WEBHOOK_SECRET=

# === Stripe ===
# Clave secreta de Stripe, SOLO en servidor.
STRIPE_SECRET_KEY=
# Secreto para verificar la firma de los webhooks de Stripe.
STRIPE_WEBHOOK_SECRET=
# Clave publicable de Stripe, expuesta al cliente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Client ID de la aplicación de Stripe Connect (onboarding de proveedores).
STRIPE_CONNECT_CLIENT_ID=

# === Mapbox ===
# Token público de Mapbox para mapas en el cliente.
NEXT_PUBLIC_MAPBOX_TOKEN=

# === Resend ===
# API key de Resend para envío de email transaccional (confirmaciones de
# reserva, recordatorios, reset de password).
RESEND_API_KEY=
# Remitente por defecto que usa `sendEmail()` cuando no se le pasa `from`.
# - Producción / dominio verificado: `Yaiwell <noreply@yaiwell.com>`.
# - Local sin dominio verificado: `Yaiwell Sandbox <onboarding@resend.dev>`
#   (Resend solo deja enviar al email con el que se registró la cuenta).
EMAIL_FROM_DEFAULT=

# === Mailchimp (marketing) ===
# API key de Mailchimp para newsletters y captación. NO se usa para email
# transaccional (eso va por Resend). Ver decisión en CLAUDE.md §2.
MAILCHIMP_API_KEY=
# ID de la audience (lista) por defecto donde se da de alta a los nuevos
# usuarios que opten in al newsletter.
MAILCHIMP_AUDIENCE_ID=
# Prefijo del datacenter de Mailchimp (ej. `us21`), visible al final de la
# API key (`xxx-us21`). Necesario para construir las URLs de la API.
MAILCHIMP_SERVER_PREFIX=

# === Sentry ===
# DSN público de Sentry (expuesto al cliente). Sin este valor el SDK
# queda como no-op y no envía nada — útil para builds sin secretos.
NEXT_PUBLIC_SENTRY_DSN=
# Auth token con scopes `project:read`, `project:releases`, `org:read`
# para que el build de Vercel pueda subir source maps y crear releases.
SENTRY_AUTH_TOKEN=
# Slug de la organización en Sentry (la URL del dashboard la muestra).
SENTRY_ORG=
# Slug del proyecto en Sentry (típicamente `yaiwell-web`).
SENTRY_PROJECT=
# Entorno reportado a Sentry (`development`, `preview`, `production`).
# Si no se define, cae al `NODE_ENV`. Útil para diferenciar preview de prod.
SENTRY_ENVIRONMENT=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Release tag. En Vercel se inyecta automáticamente `VERCEL_GIT_COMMIT_SHA`;
# en local lo puedes dejar vacío (Sentry usará `unknown`).
NEXT_PUBLIC_SENTRY_RELEASE=

# === App ===
# URL base de la aplicación. En local apunta a localhost; en producción
# debe ser la URL pública (https://yaiwell.com o similar).
NEXT_PUBLIC_APP_URL=http://localhost:3000
