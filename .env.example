# Plantilla de variables de entorno para Yaiwell.
#
# Este archivo SÍ se commitea: sirve como referencia para que cualquier
# desarrollador sepa qué variables necesita configurar. Los valores reales
# (claves, secretos, URLs de producción) van en `.env.local`, que está
# gitignored y NUNCA debe subirse al repositorio.
#
# Copia este archivo a `.env.local` y rellena los valores antes de arrancar
# el proyecto en local.

# === Supabase ===
# URL de conexión Postgres (con pgbouncer/pooling para serverless).
DATABASE_URL=
# URL directa a Postgres (sin pooler) para migraciones de Prisma.
DIRECT_URL=
# URL pública del proyecto Supabase, expuesta al cliente.
NEXT_PUBLIC_SUPABASE_URL=
# Clave anónima pública de Supabase, expuesta al cliente.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service role de Supabase, SOLO en servidor. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# === Clerk ===
# Clave publicable de Clerk, expuesta al cliente.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Clave secreta de Clerk, SOLO en servidor.
CLERK_SECRET_KEY=
# Secreto para verificar la firma de los webhooks de Clerk.
CLERK_WEBHOOK_SECRET=

# === Stripe ===
# Clave secreta de Stripe, SOLO en servidor.
STRIPE_SECRET_KEY=
# Secreto para verificar la firma de los webhooks de Stripe.
STRIPE_WEBHOOK_SECRET=
# Clave publicable de Stripe, expuesta al cliente.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Client ID de la aplicación de Stripe Connect (onboarding de proveedores).
STRIPE_CONNECT_CLIENT_ID=

# === Mapbox ===
# Token público de Mapbox para mapas en el cliente.
NEXT_PUBLIC_MAPBOX_TOKEN=

# === Resend ===
# API key de Resend para envío de email transaccional.
RESEND_API_KEY=

# === App ===
# URL base de la aplicación. En local apunta a localhost; en producción
# debe ser la URL pública (https://yaiwell.com o similar).
NEXT_PUBLIC_APP_URL=http://localhost:3000
