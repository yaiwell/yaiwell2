// Esquema de base de datos de Yaiwell.
//
// Source of truth canónica para el modelo de datos del marketplace.
// Mantener sincronizado con `src/types/domain.ts` (UI) y con CLAUDE.md §4
// (descripción funcional de cada entidad). Cualquier ruptura del modelo
// debe documentarse en un ADR bajo `docs/adr/` antes de la migración.
//
// Decisiones clave:
//
// - **PostGIS**: la columna `Provider.location` usa `geography(Point,4326)`
//   via `Unsupported` porque Prisma todavía no tiene un tipo nativo. Las
//   queries geoespaciales (`ST_DWithin`, `<->`) viven en raw SQL en
//   `lib/services/search/` para que el resto de Prisma client siga tipado.
// - **Full-text search**: `Service.searchVector` es `tsvector` generado por
//   trigger en una migración SQL aparte. No exponemos el tipo a Prisma; el
//   ranking se hace por raw query.
// - **Textos localizados**: campos como `Category.name`, `Provider.description`
//   o `Service.name` viven como `Json` con forma `LocalizedText`:
//   `{ es: string; ca?: string; en?: string; de?: string }`. **Solo `es` está
//   garantizado**, y lo garantiza el código, no la BD: todo borde de escritura
//   pasa por `buildLocalizedText()` / `storableLocalizedTextSchema`, que
//   duplican en `es` el idioma en que escribió el proveedor. Las filas
//   anteriores a ese guardián se curan con `prisma/backfill-localized-es.ts`.
//   Es la forma más sencilla de modelar 4 locales sin explosión de columnas;
//   si el volumen de traducción crece, migramos a una tabla auxiliar.
// - **Soft delete**: `deletedAt` nullable en las entidades editables por el
//   proveedor (Provider, Professional, Service). El resto se borra duro
//   porque pertenece a logs (Booking, Review, VerificationRequest).
// - **Sincronización con Clerk**: `User.clerkId` es la fuente de verdad de
//   identidad; el webhook `/api/webhooks/clerk` crea/actualiza este registro
//   antes de cualquier operación de negocio.
// - **RLS**: las policies viven en SQL crudo en `prisma/migrations/`. Sin
//   RLS no se promociona una tabla nueva a producción.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"

  // En Prisma 7 la URL (`url`) vive en `prisma.config.ts`. Desde ahí
  // pasamos `DATABASE_URL` (Session pooler de Supabase, port 5432).
  //
  // Extensiones gestionadas por Yaiwell (las necesita el dominio):
  // - postgis: queries geoespaciales (ST_DWithin para "cerca de mí").
  // - pg_trgm: fuzzy matching en el buscador full-text.
  // - uuid-ossp: generación server-side de UUIDs (@default(uuid())).
  //
  // Extensiones pre-instaladas por Supabase (las declaramos aquí para
  // que Prisma no detecte drift; no las usamos directamente):
  // - pg_stat_statements: estadísticas de queries (observabilidad).
  // - pgcrypto: utilidades criptográficas (las usa Supabase Auth).
  // - supabase_vault: cifrado de secretos (lo usa Supabase Vault).
  extensions = [postgis, pg_trgm, uuid_ossp(map: "uuid-ossp"), pg_stat_statements, pgcrypto, supabase_vault]
}

// =========================================================================
// Enums
// =========================================================================

enum UserRole {
  client
  provider
  admin
}

enum Locale {
  es
  ca
  en
  de
}

enum ProviderType {
  autonomo
  centro
}

enum PriceRange {
  euro  @map("€")
  euro2 @map("€€")
  euro3 @map("€€€")
}

enum BookingStatus {
  pending
  confirmed
  completed
  cancelled
  refunded
  /// El cliente no se presentó; lo marca el profesional desde el panel
  /// (migración 9f). El negocio puede deshacerlo en 24 h; después, soporte.
  no_show
}

/// Cómo paga el cliente la reserva (migración 9f). `onsite` nace
/// `confirmed` sin PaymentIntent y la comisión se cobra al negocio en
/// su factura mensual (`OnsiteCommissionCharge`).
enum BookingPaymentMode {
  online
  onsite
}

/// Estado de la comisión de una reserva en el local completada:
/// `pending` → `itemized` (concepto creado en Stripe) → `invoiced`
/// (factura finalizada) → `paid` | `failed`. `void` si se anula a mano.
enum OnsiteCommissionStatus {
  pending
  itemized
  invoiced
  paid
  failed
  void
}

/// Estado guardado de una oferta de hueco. «Vendida» (hay una reserva
/// confirmada con `slotOfferId`) y «caducada» (`expiresAt` pasado) se
/// derivan al leer: así ni el webhook de Stripe ni un cron tienen que
/// actualizar esta tabla.
enum SlotOfferStatus {
  active
  withdrawn
}

enum VerificationStatus {
  pending
  approved
  rejected
}

enum PlanTier {
  free
  basic
  pro
  premium
}

// =========================================================================
// Identidad y cuentas
// =========================================================================

/// Cuenta de usuario sincronizada con Clerk vía webhook.
///
/// La fuente de verdad de auth es Clerk; aquí guardamos solo el perfil
/// mínimo necesario para joins (rol, idioma preferido, email para emails
/// transaccionales). Nunca almacenamos hashes ni contraseñas.
model User {
  id        String   @id @default(uuid())
  clerkId   String   @unique
  email     String   @unique
  role      UserRole @default(client)
  locale    Locale   @default(es)
  fullName  String?
  avatarUrl String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  providers Provider[]       @relation("ProviderOwner")
  bookings  Booking[]        @relation("ClientBookings")
  reviews   Review[]
  sanctions ClientSanction[]

  @@index([role])
  @@index([deletedAt])
  @@map("users")
}

// =========================================================================
// Catálogo (categorías)
// =========================================================================

/// Categoría jerárquica (hasta 3 niveles vía `parentId`).
///
/// Convención: el slug es estable y se usa en URLs. El icono es el nombre
/// del componente Lucide (ej. "Scissors") — el render lo resuelve en cliente.
model Category {
  id       String  @id @default(uuid())
  slug     String  @unique
  /// `LocalizedText`: `{ es: "Peluquería", ca: "Perruqueria", … }`. `es` obligatorio.
  name     Json
  parentId String?
  /// Nombre del componente lucide-react. Validado en seed.
  icon     String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Self-relation para jerarquía.
  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryParent")

  // Categorías que ofrece un proveedor (M2M).
  providers ProviderCategory[]
  services  Service[]

  @@index([parentId])
  @@map("categories")
}

// =========================================================================
// Proveedores y profesionales
// =========================================================================

/// Proveedor del marketplace: autónomo (1 profesional) o centro (N).
///
/// La ubicación se guarda como PostGIS geography(Point, 4326) para
/// permitir queries `ST_DWithin` precisas (en metros). Las fotos son
/// URLs públicas en Supabase Storage; el orden importa (primera =
/// portada en cards).
model Provider {
  id                   String                                @id @default(uuid())
  /// Dueño (cuenta Clerk con role=provider). Un usuario puede ser dueño de
  /// varios centros — necesario para el caso "multi-centro" de Fase 1.
  userId               String
  type                 ProviderType
  businessName         String
  slug                 String                                @unique
  vatNumber            String?
  /// `LocalizedText`: `es` obligatorio, `ca`/`en`/`de` opcionales.
  description          Json
  address              String
  /// `geography(Point, 4326)` en PostGIS. Lng primero, Lat segundo.
  /// Las queries geo van por raw SQL en `lib/services/search/`.
  location             Unsupported("geography(Point, 4326)")
  /// URLs absolutas. La primera es la portada.
  photos               String[]
  priceRange           PriceRange
  /// Caché de valoraciones: media 1-5 redondeada a 1 decimal (0 si no hay
  /// reseñas) y número de reseñas. La mantiene el trigger
  /// `trg_reviews_refresh_provider_rating` (migración `9a_provider_rating_cache`) en cada INSERT,
  /// DELETE o cambio de `rating`, `providerId` o `bookingId` en `reviews`; no escribir a mano. No toca
  /// `updatedAt`. `ratingCount = 0` se pinta como «Nuevo en Yaiwell».
  /// Permite ordenar en `searchProviders` sin agregar por cada query.
  ratingAvg            Float                                 @default(0)
  ratingCount          Int                                   @default(0)
  /// Plan de suscripción activo (free por defecto al alta).
  planId               String
  /// El negocio ofrece «pagar en el local» (migración 9f). Público a
  /// propósito: la ficha lo enseña. Al reservar se exige además método de
  /// pago listo y sin comisiones impagadas (`ProviderBilling`).
  acceptsOnsitePayment Boolean                               @default(false)

  /// Verificación operativa: solo `approved` puede recibir reservas reales.
  verificationStatus VerificationStatus @default(pending)

  /// ID de la cuenta conectada en Stripe (Express). Persistido al crear
  /// la cuenta vía Stripe Connect; null hasta que el dueño completa el
  /// onboarding desde `/panel/centro`. El detalle del estado de la cuenta
  /// (charges_enabled, payouts_enabled) NO se cachea aquí — se consulta
  /// a Stripe bajo demanda para no quedarnos desincronizados con la
  /// realidad de la cuenta conectada.
  stripeAccountId String? @unique

  /// Generated `tsvector` para FTS sobre proveedor (businessName, description,
  /// address). La columna se materializa via migración SQL (`migrations/2_fts_search/`);
  /// Prisma no la conoce, las queries de búsqueda usan raw SQL.
  /// searchVector  tsvector  -- gestionado fuera de Prisma.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relaciones
  owner                User                     @relation("ProviderOwner", fields: [userId], references: [id], onDelete: Restrict)
  plan                 Plan                     @relation(fields: [planId], references: [id], onDelete: Restrict)
  professionals        Professional[]
  services             Service[]
  bookings             Booking[]
  slotOffers           SlotOffer[]
  reviews              Review[]
  categories           ProviderCategory[]
  verificationRequests VerificationRequest[]
  billing              ProviderBilling?
  onsiteCommissions    OnsiteCommissionCharge[]

  @@index([userId])
  @@index([planId])
  @@index([verificationStatus])
  @@index([deletedAt])
  // Índice GiST sobre la geometría — necesario para ST_DWithin rápido. Se
  // crea via raw SQL en la migración inicial (Prisma no expone GiST).
  @@map("providers")
}

/// Tabla puente Provider ↔ Category (M2M).
///
/// Necesaria porque un centro puede ofrecer servicios de varias
/// categorías raíz (ej. peluquería + estética). Permite también filtrar
/// proveedores por categoría sin tener que enumerar sus servicios.
model ProviderCategory {
  providerId String
  categoryId String

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([providerId, categoryId])
  @@map("provider_categories")
}

/// Profesional que trabaja en un Provider.
///
/// En proveedores tipo `autonomo` hay exactamente 1 Professional cuyo
/// userId coincide con `Provider.userId`. En `centro` hay N profesionales
/// y cada uno puede tener su propio userId si tiene cuenta Clerk para el
/// panel; si no, `userId` es null y solo aparece en el catálogo.
model Professional {
  id            String  @id @default(uuid())
  providerId    String
  userId        String?
  name          String
  photo         String?
  bio           String?
  /// JSON con horario semanal por defecto. Estructura:
  /// `{ monday: [{open: "10:00", close: "20:00"}], ... }`.
  /// Override por día concreto vía tabla aparte `ScheduleOverride` (TBD).
  schedule      Json
  /// Buffer en minutos entre citas (limpieza/preparación). Por defecto 15.
  bufferMinutes Int     @default(15)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  provider   Provider    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  services   Service[]
  bookings   Booking[]
  slotOffers SlotOffer[]

  @@index([providerId])
  @@index([userId])
  @@index([deletedAt])
  @@map("professionals")
}

// =========================================================================
// Servicios
// =========================================================================

/// Servicio concreto ofrecido por un Provider (y opcionalmente atado a
/// un Professional específico).
///
/// Para centros con varios profesionales que ofrecen el mismo servicio,
/// `professionalId` puede ser null y el motor de availability elige el
/// hueco entre los disponibles.
model Service {
  id              String    @id @default(uuid())
  providerId      String
  professionalId  String?
  categoryId      String
  /// `LocalizedText`: `es` obligatorio, `ca`/`en`/`de` opcionales.
  name            Json
  /// `LocalizedText`: `es` obligatorio, `ca`/`en`/`de` opcionales.
  description     Json
  durationMinutes Int
  priceCents      Int
  /// `true` → publicado y reservable. `false` → pausado por el provider
  /// (oculto en búsqueda y bookings, sigue contando en métricas históricas).
  /// Default `true` para que servicios existentes y nuevos arranquen activos.
  isActive        Boolean   @default(true)
  /// Cuándo lo ocultó el límite del plan (bajada o impago). Con `isActive`
  /// a `false`; distingue «lo pausé yo» (null) de «lo ocultó el plan»: al
  /// volver a pagar solo se reactivan estos.
  pausedByPlanAt  DateTime?
  /// Generated `tsvector` para FTS sobre servicio (name, description,
  /// category_label_cache). La columna se materializa via migración SQL
  /// (`migrations/2_fts_search/`); Prisma no la conoce, las queries de
  /// búsqueda usan raw SQL.
  /// searchVector  tsvector  -- gestionado fuera de Prisma.

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  provider     Provider      @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professional Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  bookings     Booking[]
  slotOffers   SlotOffer[]

  @@index([providerId])
  @@index([professionalId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("services")
}

// =========================================================================
// Reservas y reseñas
// =========================================================================

/// Reserva de un cliente sobre un Servicio.
///
/// El cálculo de `endAt` se hace en `booking.service.ts` a partir de la
/// duración del servicio + buffer. Mantener ambos persistidos (no
/// recalcular en queries) simplifica los overlaps y las queries de
/// calendario.
///
/// Reglas de negocio críticas (ver §4.bis de CLAUDE.md):
/// - El profesional marca `completed` desde su panel; solo entonces se
///   habilita la valoración para el cliente.
/// - El proveedor puede cancelar solo si `startAt - now() >= 2h`.
/// Restricción fuera de Prisma: `bookings_no_overlap_confirmed` (EXCLUDE con
/// btree_gist, migración 9d) impide dos `confirmed` solapadas del mismo
/// profesional. No usar `migrate dev` ni `db push` contra el remoto: la
/// borrarían al no estar en este modelo.
/// CHECK fuera de Prisma `bookings_onsite_without_payment_intent`
/// (migración 9f): una reserva `onsite` nunca lleva `stripePaymentIntentId`,
/// así ningún camino de cobro online puede anclarse a ella.
model Booking {
  id                    String             @id @default(uuid())
  clientId              String
  serviceId             String
  professionalId        String
  providerId            String
  startAt               DateTime
  endAt                 DateTime
  status                BookingStatus      @default(pending)
  priceCents            Int
  /// Comisión que retiene la plataforma en céntimos. Calculada en el
  /// momento de la reserva según `Plan.commissionRate` para que cambios
  /// posteriores de plan no afecten reservas pasadas.
  commissionCents       Int
  stripePaymentIntentId String?
  /// Notas opcionales del cliente para el profesional.
  notes                 String?
  /// Marca temporal de cuándo se cambió a `completed`. Sirve para
  /// calcular la ventana de 30 días de valoración.
  completedAt           DateTime?
  /// Marca temporal de cancelación. Útil para auditoría sin tener que
  /// derivar del status (que se sobrescribe en refund).
  cancelledAt           DateTime?
  /// Id del reembolso en Stripe (`re_…`). Se rellena al emitirlo, antes
  /// de que llegue `charge.refunded`. Único: un refund, una reserva.
  stripeRefundId        String?            @unique
  /// Cuándo Stripe confirmó el reembolso (`charge.refunded`).
  refundedAt            DateTime?
  /// Último intento fallido de reembolso. Con `refundedAt` a null forma
  /// la cola que soporte revisa en /admin/reembolsos.
  refundFailedAt        DateTime?
  /// Motivo técnico del último fallo (código y mensaje de Stripe).
  refundFailureReason   String?
  /// Entrada de la cola de reembolsos descartada a mano por soporte (p. ej.
  /// `pi_cancel_failed` sin cobro real). Sale de la cola sin `refundedAt`:
  /// no hubo dinero que devolver. Quién y por qué quedan para auditoría.
  refundDismissedAt     DateTime?
  refundDismissedBy     String?
  refundDismissReason   String?
  /// Oferta de hueco liberado con la que se reservó. Con ella se congelan
  /// el precio de referencia y el descuento aplicado: `priceCents` sigue
  /// siendo lo cobrado, y la comisión se calcula sobre ese importe.
  slotOfferId           String?
  originalPriceCents    Int?
  discountPct           Int?
  /// Online (PaymentIntent) o en el local (sin cobro en la app).
  paymentMode           BookingPaymentMode @default(online)
  /// Cuándo y quién (`User.id` interno) marcó «no presentado».
  noShowAt              DateTime?
  noShowMarkedBy        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client           User                    @relation("ClientBookings", fields: [clientId], references: [id], onDelete: Restrict)
  service          Service                 @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professional     Professional            @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  provider         Provider                @relation(fields: [providerId], references: [id], onDelete: Restrict)
  review           Review?
  slotOffer        SlotOffer?              @relation("SlotOfferBookings", fields: [slotOfferId], references: [id], onDelete: SetNull)
  /// Oferta creada al liberar el hueco de esta reserva cancelada.
  releasedAs       SlotOffer?              @relation("SlotOfferSource")
  sanction         ClientSanction?
  onsiteCommission OnsiteCommissionCharge?

  @@index([clientId, startAt])
  @@index([providerId, startAt])
  @@index([professionalId, startAt])
  // Índice clave del motor de availability: para detectar solapamientos
  // basta con buscar reservas activas de un profesional en un rango.
  @@index([professionalId, status, startAt, endAt])
  @@index([status])
  @@index([slotOfferId])
  @@map("bookings")
}

/// Hueco liberado con descuento por un profesional (CLAUDE.md §4.bis).
///
/// Nace tras cancelar una reserva (`sourceBookingId`) o sobre un hueco
/// libre que empieza en menos de 2 h. El descuento va por tramos de
/// tiempo antes del inicio y lo resuelve el servidor al crear la reserva.
model SlotOffer {
  id                 String          @id @default(uuid())
  providerId         String
  professionalId     String
  serviceId          String
  /// Reserva cancelada que dejó el hueco. Única: una oferta por reserva.
  sourceBookingId    String?         @unique
  startAt            DateTime
  endAt              DateTime
  /// % de descuento por tramo de tiempo hasta el inicio. Pasos de 5,
  /// tope 50, y nunca menor en un tramo más cercano (CHECK en BD).
  discountPctOver2h  Int
  discountPct1To2h   Int
  discountPctUnder1h Int
  /// Último momento en que se puede reservar con la oferta.
  expiresAt          DateTime
  status             SlotOfferStatus @default(active)
  withdrawnAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider      Provider     @relation(fields: [providerId], references: [id], onDelete: Cascade)
  professional  Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service       Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  sourceBooking Booking?     @relation("SlotOfferSource", fields: [sourceBookingId], references: [id], onDelete: SetNull)
  bookings      Booking[]    @relation("SlotOfferBookings")

  @@index([providerId, startAt])
  @@index([professionalId, startAt])
  @@index([serviceId])
  @@index([status, startAt])
  @@map("slot_offers")
}

/// Valoración del cliente sobre un Booking completado.
///
/// FK obligatoria a Booking — no admitimos reseñas huérfanas (§4.bis).
/// La validación de "booking.status === 'completed'" se hace en
/// `review.service.ts`, no por trigger, para emitir errores tipados.
model Review {
  id                 String    @id @default(uuid())
  bookingId          String    @unique
  /// Denormalizado para joins rápidos en la ficha de proveedor.
  providerId         String
  /// Denormalizado: el autor real puede ser distinto del clientId si en el
  /// futuro permitimos invitar a co-autor. De momento coincide.
  authorId           String
  rating             Int
  text               String
  /// URLs públicas en Supabase Storage. Hasta 5 fotos (validado en service).
  photos             String[]  @default([])
  /// Respuesta del proveedor. Nullable porque la reseña existe sin respuesta.
  providerResponse   String?
  providerResponseAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([providerId, createdAt])
  @@index([rating])
  @@map("reviews")
}

// =========================================================================
// Verificación y planes
// =========================================================================

/// Solicitud de verificación de un proveedor.
///
/// La cola de moderación del admin opera sobre esta tabla; el resultado
/// (`approved`/`rejected`) se replica también en `Provider.verificationStatus`
/// para que las queries de listado no tengan que joinar.
model VerificationRequest {
  id         String             @id @default(uuid())
  providerId String
  status     VerificationStatus @default(pending)
  /// Documentos subidos (URLs en Supabase Storage privado).
  documents  String[]           @default([])
  /// `User.id` del admin que revisó.
  reviewedBy String?
  reviewedAt DateTime?
  /// Notas internas de moderación. No se muestran al proveedor.
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, status])
  @@index([status, createdAt])
  @@map("verification_requests")
}

/// Plan de suscripción del proveedor.
///
/// Stripe Billing es la fuente de verdad de pagos; aquí guardamos solo
/// los límites y la comisión para que el servicio de booking pueda
/// calcular la cuota retenida sin llamar a Stripe en cada reserva.
model Plan {
  id                String   @id @default(uuid())
  tier              PlanTier @unique
  name              String
  maxServices       Int
  monthlyPriceCents Int
  /// Tasa de comisión en centésimas (e.g. 800 = 8.00%).
  commissionRateBps Int
  /// Producto en Stripe (para el checkout de suscripción).
  stripeProductId   String?  @unique
  /// Precio mensual en Stripe (para el checkout de suscripción).
  stripePriceId     String?  @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providers         Provider[]
  billingSubscribed ProviderBilling[] @relation("BillingSubscribedPlan")
  billingScheduled  ProviderBilling[] @relation("BillingScheduledPlan")

  @@map("plans")
}

/// Estado de la suscripción en Stripe (espejo de `Subscription.status`).
enum BillingSubscriptionStatus {
  incomplete
  incomplete_expired
  trialing
  active
  past_due
  canceled
  unpaid
  paused
}

/// Facturación del negocio en Stripe Billing (1:1 con Provider).
///
/// Tabla aparte y sin lectura pública (RLS sin policies, migración 9e):
/// la policy pública de `providers` expone todas sus columnas. El plan
/// efectivo sigue en `Provider.planId`; aquí solo el espejo de Stripe.
/// La fila nace al crear el Customer, que sirve a cualquier plan (también
/// para cobrar en el futuro las comisiones del pago en el local).
model ProviderBilling {
  id                          String                     @id @default(uuid())
  providerId                  String                     @unique
  stripeCustomerId            String                     @unique
  /// Suscripción en curso (la última sincronizada).
  stripeSubscriptionId        String?                    @unique
  subscriptionStatus          BillingSubscriptionStatus?
  /// Plan que paga según Stripe; en impago puede no coincidir con el efectivo.
  subscribedPlanId            String?
  currentPeriodEnd            DateTime?
  cancelAtPeriodEnd           Boolean                    @default(false)
  /// Bajada programada a fin de periodo.
  scheduledPlanId             String?
  scheduledChangeAt           DateTime?
  lastPaymentFailedAt         DateTime?
  /// `${invoiceId}:${attempt}`: evita repetir el aviso si Stripe reenvía el evento.
  lastFailureNotifiedKey      String?
  lastSyncedAt                DateTime?
  /// Método de pago por defecto guardado para cobrar las comisiones del
  /// pago en el local (Checkout `mode: 'setup'`). Requisito para activarlo.
  onsitePaymentMethodReadyAt  DateTime?
  /// Último periodo (`YYYY-MM`, hora de Madrid) con factura suelta de
  /// comisiones emitida; solo negocios sin suscripción viva.
  lastCommissionInvoicePeriod String?
  /// Primer fallo de cobro de comisiones sin resolver. Mientras tenga
  /// valor, el negocio no admite reservas nuevas en el local.
  commissionDebtSince         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provider       Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  subscribedPlan Plan?    @relation("BillingSubscribedPlan", fields: [subscribedPlanId], references: [id], onDelete: Restrict)
  scheduledPlan  Plan?    @relation("BillingScheduledPlan", fields: [scheduledPlanId], references: [id], onDelete: Restrict)

  @@index([subscribedPlanId])
  @@index([scheduledPlanId])
  @@map("provider_billing")
}

// =========================================================================
// Pago en el local: sanciones y comisiones (migración 9f)
// =========================================================================

/// Sanción a un cliente por no presentarse a una reserva en el local
/// (CLAUDE.md §4.bis). Una por reserva (`bookingId` único). El bloqueo
/// de 3 meses tras 3 sanciones en 12 meses **no se guarda**: lo calcula
/// `computeOnlineOnlyUntil` a partir de las sanciones no revocadas.
///
/// Sin lectura pública (RLS sin policies, migración 9f).
model ClientSanction {
  id           String    @id @default(uuid())
  userId       String
  bookingId    String    @unique
  /// De momento solo `'no_show'`. Lo impone el CHECK `client_sanctions_reason_check`
  /// (migración 9f, fuera de Prisma: no usar `migrate dev` ni `db push`).
  reason       String
  /// Instante que cuenta para la ventana de 12 meses (= `Booking.startAt`).
  occurredAt   DateTime
  /// Revocación por el negocio (deshacer en 24 h) o por soporte.
  revokedAt    DateTime?
  /// `User.id` interno de quien la revocó.
  revokedBy    String?
  revokeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  // El índice parcial `(userId, occurredAt) WHERE revokedAt IS NULL` vive
  // en la migración: Prisma no expresa índices parciales.
  @@map("client_sanctions")
}

/// Comisión de una reserva en el local completada, a cobrar al negocio en
/// su factura de Stripe Billing. Una por reserva (`bookingId` único).
///
/// Sin lectura pública (RLS sin policies, migración 9f). CHECK fuera de
/// Prisma: `amountCents >= 0`.
model OnsiteCommissionCharge {
  id                  String                 @id @default(uuid())
  bookingId           String                 @unique
  providerId          String
  /// Comisión congelada en la reserva (`Booking.commissionCents`).
  amountCents         Int
  status              OnsiteCommissionStatus @default(pending)
  stripeInvoiceItemId String?                @unique
  stripeInvoiceId     String?
  itemizedAt          DateTime?
  invoicedAt          DateTime?
  paidAt              DateTime?
  lastErrorAt         DateTime?
  lastError           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([providerId, status])
  @@index([stripeInvoiceId])
  @@map("onsite_commission_charges")
}
